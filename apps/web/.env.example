# Database (Turso)
# For local development, use file:local.db
# For production, use libsql://your-database.turso.io
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Authentication (Better Auth)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-min-32-characters-long

# Application URLs
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated origins allowed to call extension API routes. Add the exact
# chrome-extension://<extension-id> origin after loading the extension.
ALLOWED_CORS_ORIGINS=http://localhost:3000

# Contact URL or email sent in the geocoder User-Agent, as OpenStreetMap's
# Nominatim usage policy requires. Falls back to NEXT_PUBLIC_APP_URL.
NOMINATIM_CONTACT=http://localhost:3000
